#!/bin/sh
# rs — DOMjudge Rust compile script; rustc comes from the Nix closure and links with the chroot's cc.
DEST="$1"
shift 2 # DEST, MEMLIMIT

# rustc needs a writable TMPDIR, and the judging chroot has no /tmp.
mkdir rust_tmp_dir
TMPDIR=rust_tmp_dir @rust@/bin/rustc --edition 2021 -C opt-level=3 -o "$DEST" "$@"
EXITCODE=$?
rm -rf rust_tmp_dir
# Keep rustc's exit status: upstream's script reports a failed compile as success.
exit $EXITCODE
