# .envrc — direnv: the flake's devshell, which installs the git hooks on entry.
# nix-direnv rebuilds the cached shell only when flake.nix or flake.lock change;
# the hooks it installs come from these, so a stale shell would install old ones.
watch_file modules/meta/devshell.nix modules/meta/pre-commit.nix modules/meta/formatter.nix
use flake
