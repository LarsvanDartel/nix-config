#!/bin/sh
# js — DOMjudge JavaScript compile script; Node.js comes from the Nix closure mounted at /nix.
DEST="$1"
MEMLIMIT="$2"
shift 2
MAINSOURCE="${ENTRY_POINT:-$1}"
if [ -z "$ENTRY_POINT" ]; then
	echo "Info: detected entry_point: $MAINSOURCE"
fi

for file in "$@"; do
	case $file in
	*.js) @node@ --check "$file" || exit ;;
	esac
done

# V8 stops at its own ~1 MB stack (runguard leaves it unlimited): half the memory limit
# lets deep recursion behave as in the compiled languages.
cat >"$DEST" <<EOF
#!/bin/sh
if [ "\${0%/*}" != "\$0" ]; then
	cd "\${0%/*}"
fi
exec @node@ --stack-size=$((MEMLIMIT / 2)) "$MAINSOURCE" "\$@"
EOF
chmod a+x "$DEST"
