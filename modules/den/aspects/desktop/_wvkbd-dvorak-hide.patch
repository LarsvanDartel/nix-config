# wvkbd-dvorak-hide.patch — wvkbd-mobintl: Dvorak letters in the portrait and landscape layouts, and a ▾ key that hides the keyboard (desktop.tablet).

--- a/keyboard.h
+++ b/keyboard.h
@@ -24,6 +24,7 @@
 	NextLayer, // Layout switch to the next layout in the layers sequence
 	Compose,   // Compose modifier key, switches to a specific associated layout
 	           // upon next keypress
+	Hide,      // Hides the keyboard, as SIGUSR1 does
 	EndRow,    // Incidates the end of a key row
 	Last,      // Indicated the end of a layout
 };
--- a/keyboard.c
+++ b/keyboard.c
@@ -2,6 +2,8 @@
 #include <linux/input-event-codes.h>
 #include <stddef.h>
 #include <stdio.h>
+#include <signal.h>
+#include <unistd.h>
 #include <sys/mman.h>
 #include <ctype.h>
 #include "keyboard.h"
@@ -427,6 +429,10 @@
     }

     switch (k->type) {
+    case Hide:
+        // main.c reads SIGUSR1 from its signalfd and hides.
+        kill(getpid(), SIGUSR1);
+        break;
     case Code:
         if (k->code_mod) {
             zwp_virtual_keyboard_v1_key_mods(kb->vkbd, time, k->code_mod, WL_KEYBOARD_KEY_STATE_PRESSED);
